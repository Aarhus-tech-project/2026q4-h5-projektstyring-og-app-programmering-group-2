# Copy to .env (gitignored) and fill in. docker compose reads .env automatically.

# Postgres login, used by the database, the server and Grafana's Postgres datasource
POSTGRES_USER=app
POSTGRES_PASSWORD='change-me'

# Grafana admin login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD='change-me'

# Azure Storage connection string for the account holding the `uploads` and `media` containers
BLOBS_CONNECTION_STRING='DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net'

# JWT signing key, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_KEY='change-me-local-dev-key-at-least-32-chars'

# Optional, defaults shown
# ASPNETCORE_ENVIRONMENT=Development
# SERVER_PORT=8080
# POSTGRES_DB=app
