[
  {
    "label": "Expo: start",
    "command": "npx expo start",
    "cwd": "$ZED_WORKTREE_ROOT/App",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Expo: run iOS",
    "command": "npx expo run:ios",
    "cwd": "$ZED_WORKTREE_ROOT/App",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Expo: prebuild",
    "command": "npx expo prebuild",
    "cwd": "$ZED_WORKTREE_ROOT/App",
    "allow_concurrent_runs": false
  },
  {
    "label": "App: typecheck + lint",
    "command": "npx tsc --noEmit && npx expo lint",
    "cwd": "$ZED_WORKTREE_ROOT/App"
  },
  {
    "label": "Server: dotnet run",
    "command": "dotnet run",
    "cwd": "$ZED_WORKTREE_ROOT/Server",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  },
  {
    "label": "Server: dotnet watch",
    "command": "dotnet watch",
    "cwd": "$ZED_WORKTREE_ROOT/Server",
    "use_new_terminal": true,
    "allow_concurrent_runs": false
  }
]
