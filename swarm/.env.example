# Copy to .env (gitignored) next to docker-compose.yml and fill in. `docker stack deploy` doesn't
# read it by itself: run `set -a; . ./.env; set +a` before deploying. Keep values with special
# characters in single quotes, the shell reads this file.

# Postgres login, used by the database, the server and Grafana's Postgres datasource
POSTGRES_USER=app
POSTGRES_PASSWORD='change-me'

# Grafana admin login
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD='change-me'

# Azure Storage connection string for the account holding the `uploads` and `media` containers
BLOBS_CONNECTION_STRING='DefaultEndpointsProtocol=https;AccountName=...;AccountKey=...;EndpointSuffix=core.windows.net'

# JWT signing key, at least 32 characters. Generate one with: openssl rand -base64 48
JWT_KEY='change-me-at-least-32-characters-long-key'

# Optional, defaults shown
# IMAGE_TAG=latest              # or sha-<short sha> to pin a CI build
# ASPNETCORE_ENVIRONMENT=Production
# POSTGRES_DB=app
# SERVER_PORT=8080
# SERVER_REPLICAS=2
# GRAFANA_PORT=3000
# CLOUDFLARED_REPLICAS=0        # set to 2 together with the token to turn the tunnel on
# CLOUDFLARE_TUNNEL_TOKEN=
