    {
      "type": "timeseries",
      "title": "RAM per process",
      "description": "Memory each .NET process uses. Climbing steadily for hours or days without dropping = memory leak.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "dotnet_process_memory_working_set_bytes",
          "legendFormat": "{{job}} {{instance}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "CPU per process",
      "description": "100% = the process is using every core it can. The vote worker spikes briefly once a minute.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * sum by (job, instance) (rate(dotnet_process_cpu_time_seconds_total[$__rate_interval])) / on (job, instance) dotnet_process_cpu_count",
          "legendFormat": "{{job}} {{instance}}",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 15,
      "gridPos": {
        "x": 8,
        "y": 24,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "timeseries",
      "title": "Postgres connections",
      "description": "Npgsql connection pool per process. 'waiting' above 0 means requests are queuing for a free connection.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, instance, db_client_connection_state) (db_client_connection_count)",
          "legendFormat": "{{job}} {{instance}} {{db_client_connection_state}}",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (job, instance) (db_client_connection_npgsql_pending_requests)",
          "legendFormat": "{{job}} {{instance}} waiting",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 16,
      "gridPos": {
        "x": 16,
        "y": 24,
        "w": 8,
        "h": 8
      }
    },
    {
      "type": "row",
      "title": "Server",
      "id": 17,
      "collapsed": false,
      "panels": [],
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 24,
        "h": 1
      }
    },
    {
      "type": "timeseries",
      "title": "Server CPU, RAM and disk used",
      "description": "The whole machine, including Postgres and the monitoring stack. Only on the Swarm stack (node-exporter).",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "CPU",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 * (1 - node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)",
          "legendFormat": "RAM",
          "editorMode": "code",
          "range": true
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "100 - min(100 * node_filesystem_avail_bytes{mountpoint=~\"/|/var|/var/lib|/var/lib/docker\",fstype!~\"tmpfs|rootfs|overlay|squashfs|9p\"} / node_filesystem_size_bytes{mountpoint=~\"/|/var|/var/lib|/var/lib/docker\",fstype!~\"tmpfs|rootfs|overlay|squashfs|9p\"})",
          "legendFormat": "Disk",
          "editorMode": "code",
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "lineWidth": 1,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": true
          },
          "color": {
            "mode": "palette-classic"
          },
          "min": 0,
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "id": 18,
      "gridPos": {
        "x": 0,
        "y": 33,
        "w": 24,
        "h": 8
      }
    }
  ]
