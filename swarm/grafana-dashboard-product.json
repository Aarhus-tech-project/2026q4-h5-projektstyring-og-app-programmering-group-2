    {
      "type": "table",
      "title": "Top posts",
      "description": "Highest ELO among posts that haven't been deleted.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT u.username AS \"User\", round(p.elo) AS \"ELO\", p.wins AS \"Wins\", p.losses AS \"Losses\", p.created_at AS \"Posted\"\nFROM posts p\nJOIN users u ON u.id = p.user_id\nWHERE p.deleted_at IS NULL\nORDER BY p.elo DESC\nLIMIT 10",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 14,
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 10
      }
    },
    {
      "type": "table",
      "title": "Top users",
      "description": "Users ranked by their best post's ELO. Wins and losses are summed over all their posts.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT username AS \"User\", round(elo) AS \"Best ELO\", wins AS \"Wins\", losses AS \"Losses\",\n       CASE WHEN wins + losses > 0 THEN round(100.0 * wins / (wins + losses)) END AS \"Win %\"\nFROM users\nORDER BY elo DESC\nLIMIT 10",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Win %"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false
        }
      },
      "id": 15,
