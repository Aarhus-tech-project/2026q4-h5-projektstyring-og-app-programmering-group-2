    {
      "type": "bargauge",
      "title": "Cameras",
      "description": "Cameras in the photos' EXIF data, avatars included. Photos without camera info are left out.",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "postgres"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "postgres"
          },
          "rawSql": "SELECT concat_ws(' ', camera_make, camera_model) AS camera, count(*) AS photos\nFROM media\nWHERE camera_model IS NOT NULL\nGROUP BY 1\nORDER BY 2 DESC\nLIMIT 10",
          "format": "table",
          "rawQuery": true,
          "editorMode": "code"
